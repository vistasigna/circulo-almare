# ---- Obrigatórias ----
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
JWT_SECRET=um-texto-longo-e-aleatorio-so-seu
ADMIN_SENHA=senha-do-painel-admin
BASE_URL=https://circulo-almare-production.up.railway.app

# ---- Pagamento: InfinitePay (checkout hospedado, PIX taxa zero + cartão até 12x) ----
# InfiniteTag da conta InfinitePay, SEM o "$" (ex.: se no app aparece $vistasigna, coloque vistasigna)
INFINITEPAY_HANDLE=sua_infinitetag
# Opcional. Se não definir, o segredo do webhook é derivado do JWT_SECRET automaticamente.
# INFINITEPAY_WEBHOOK_SECRET=
# Nada a configurar no painel da InfinitePay: o endereço do webhook vai junto em cada link de pagamento.

# ---- ERP (Bling) — conexão própria e isolada do Círculo ----
CIRCULO_BLING_CLIENT_ID=
CIRCULO_BLING_CLIENT_SECRET=
CIRCULO_BLING_REDIRECT_URI=

# ---- IA (identificar obra por foto) ----
ANTHROPIC_API_KEY=

# ---- E-mail (envio de mensagens do Círculo) ----
EMAIL_USER=
EMAIL_APP_PASSWORD=
